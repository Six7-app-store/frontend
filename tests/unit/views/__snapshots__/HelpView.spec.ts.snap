      <li><a href="#help-areas" class="block py-1 pl-3 text-sm text-fg-muted transition-colors hover:text-heading">Die Bereiche der App</a></li>
      <li><a href="#help-links" class="block py-1 pl-3 text-sm text-fg-muted transition-colors hover:text-heading">Nützliche Projektlinks</a></li>
      <li><a href="#help-docs" class="block py-1 pl-3 text-sm text-fg-muted transition-colors hover:text-heading">Dokumentation</a></li>
