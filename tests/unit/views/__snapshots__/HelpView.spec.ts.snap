exports[`HelpView (en) > matches snapshot 1`] = `
"<div class="grid max-w-detail grid-cols-1 items-start gap-16 lg:grid-cols-[minmax(0,var(--reading-max))_var(--toc-w)]">
  <article class="min-w-0">
    <div class="mb-section flex flex-wrap justify-between gap-4 items-end">
      <div class="min-w-0">
        <h1 class="font-semibold text-heading text-4xl tracking-[-0.01em]">Help &amp; Q/A</h1>
        <p class="mt-1.5 text-base text-fg-muted">Support &amp; frequently asked questions.</p>
      </div>
      <!--v-if-->
    </div>
    <div class="help-article flex flex-col gap-4">
      <p>This page explains the most important steps for users who are already signed in. You get concrete guidance for deployments, quotas and next practical steps.</p>
      <h2 id="help-problems">If something does not work</h2>
      <p>This checklist helps you find the most common blockers quickly and understand what to check next.</p>
      <ul class="list-disc pl-5">
        <li>Check whether you have reached your quota limit.</li>
        <li>Look at deployment details and logs to narrow down the issue.</li>
      </ul>
      <h2 id="help-steps">Step-by-step guide</h2>
      <h3>Deployment process</h3>
      <ol class="list-decimal pl-[22px]">
        <li>Open the deployments overview and start a new deployment.</li>
        <li>Choose the desired app and app version.</li>
        <li>Assign the deployment to a course or team and adjust the settings.</li>
        <li>Review your current quotas before launching the deployment.</li>
        <li>Start the deployment and monitor status and logs in the detail view.</li>
      </ol>
      <h2 id="help-areas">Areas of the app</h2>
      <dl class="flex flex-col gap-0.5">
        <dt class="font-semibold text-heading">Dashboard</dt>
        <dd class="mb-3">Quickly see active deployments, system health, and available resources.</dd>
        <dt class="font-semibold text-heading">Apps</dt>
        <dd class="mb-3">Verify the app you need or add new applications and versions.</dd>
        <dt class="font-semibold text-heading">Courses</dt>
        <dd class="mb-3">Link deployments to courses and organize participant groups.</dd>
        <dt class="font-semibold text-heading">Deployments</dt>
        <dd class="mb-3">Create deployments, check status, and investigate errors.</dd>
      </dl>
      <h2 id="help-links">Useful project links</h2>
      <p>Quick access to the relevant GitHub repositories.</p>
      <ul class="list-disc pl-5">
        <li><a href="https://github.com/six7-click-n-deploy/frontend" target="_blank" rel="noopener noreferrer" class="link">GitHub: frontend repository</a></li>
        <li><a href="https://github.com/six7-click-n-deploy/backend" target="_blank" rel="noopener noreferrer" class="link">GitHub: backend repository</a></li>
        <li><a href="https://github.com/six7-click-n-deploy/deployment" target="_blank" rel="noopener noreferrer" class="link">GitHub: deployment repository</a></li>
        <li><a href="https://github.com/six7-click-n-deploy/worker" target="_blank" rel="noopener noreferrer" class="link">GitHub: worker repository</a></li>
      </ul>
      <h2 id="help-docs">Documentation</h2>
      <p>Direct access to the relevant project documentation.</p>
      <ul class="list-disc pl-5">
        <li><a href="https://github.com/six7-click-n-deploy/deployment/blob/main/README.md" target="_blank" rel="noopener noreferrer" class="link">Documentation regarding Installation and Administration</a></li>
        <li><a href="https://github.com/six7-click-n-deploy/.github/blob/main/docs/technologiestack.md" target="_blank" rel="noopener noreferrer" class="link">Documentation regarding Technology Stack and Architecture</a></li>
        <li><a href="https://github.com/six7-click-n-deploy/template-app/blob/main/README.md" target="_blank" rel="noopener noreferrer" class="link">Documentation for App Developers: Creating a new App Template</a></li>
      </ul>
    </div>
  </article>
  <nav aria-label="On this page" class="hidden pt-2 lg:sticky lg:top-0 lg:block">
    <p class="mb-2 text-xs font-semibold text-fg-subtle">On this page</p>
