                        <div class="text-xs text-fg-muted truncate">annabelle@example.com</div>
                      </div>
                    </div>
                    <!--v-if-->
                    <div class="flex-shrink-0 flex lg:justify-end"><button title="Mail mit Zugangsdaten an diesen Nutzer erneut senden" class="w-full lg:w-auto flex items-center justify-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border transition-colors bg-panel text-fg border-strong hover:bg-line/[.04] disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send-icon lucide-send">
                          <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
                          <path d="m21.854 2.147-10.94 10.939"></path>
                        </svg><span>Zugang erneut senden</span></button></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- Infrastructure section — per-VM cards + read-only listings.
             Owner-only (the backend gates it the same way); members
             skip the section entirely so they don't see an empty/
             permission-error panel. Visually mirrors the other
             page sections (Teams, Tasks, Outputs): same
             \`\`bg-panel rounded-xl border ... p-6 shadow-sm\`\` shell,
             same icon-tile header, same sub-section spacing. -->
        <section class="surface-panel">
          <header class="panel-head">
            <h2 class="flex min-w-0 items-baseline gap-2 text-md font-semibold text-heading"><span class="truncate">Infrastruktur</span>
              <!--v-if-->
            </h2>
            <div class="flex shrink-0 items-center gap-2"><button class="btn btn-secondary btn-sm" title="Live-Status neu abfragen"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw-icon lucide-refresh-cw" aria-hidden="true">
                  <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                  <path d="M21 3v5h-5"></path>
                  <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                  <path d="M8 16H3v5"></path>
                </svg> Aktualisieren
                <!--v-if-->
              </button></div>
          </header>
          <div class="p-panel">
            <div class="flex flex-col gap-6">
              <!--v-if-->
              <!-- VMs: the primary listing; the cards bring their own styling. -->
              <section class="flex flex-col gap-3">
                <h3 class="flex items-baseline gap-2 text-sm font-semibold text-heading">Virtuelle Maschinen <span class="font-normal tabular-nums text-fg-muted">1</span></h3>
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                  <div class="flex flex-col gap-3 rounded-panel border bg-panel p-4 transition-colors border-subtle">
                    <!-- Header: Team-Badge + VM-Name + Lifecycle-Pill -->
                    <div class="flex items-start justify-between gap-2">
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1"><span class="text-xs font-semibold px-2 py-0.5 rounded border bg-line/[.07] text-fg border-subtle">Team Alpha</span></div>
                        <h3 class="text-base font-semibold text-fg truncate" title="team-alpha-ide">team-alpha-ide</h3>
                      </div><span class="text-[11px] font-semibold px-2 py-1 rounded border whitespace-nowrap status-success">ACTIVE</span>
                    </div><!-- Drift banner -->
                    <!--v-if-->
                    <!-- Fault banner — only when status=ERROR -->
                    <!--v-if-->
                    <!-- Hardware row -->
                    <div class="flex items-start gap-2 text-xs text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide mt-0.5 shrink-0 text-icon lucide-cpu-icon lucide-cpu mt-0.5 shrink-0 text-icon">
