        <section class="surface-panel">
          <header class="panel-head">
            <h2 class="flex min-w-0 items-baseline gap-2 text-md font-semibold text-heading"><span class="truncate">Teams &amp; Mitglieder</span><span class="text-sm font-normal tabular-nums text-fg-muted">2</span></h2>
