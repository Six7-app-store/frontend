                        <div data-testid="member-username" class="truncate font-semibold text-heading">anna</div>
                        <div class="text-xs text-fg-muted truncate">anna.schmidt@example.com</div>
                      </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-fg-muted lg:justify-end">
                      <!--v-if-->
                      <!-- Connection pill. \`\`web\`\` renders a link, everything else plain
