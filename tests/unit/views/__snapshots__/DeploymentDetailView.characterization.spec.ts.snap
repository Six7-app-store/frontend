                      <div class="flex items-center gap-1.5 rounded-tag border border-faint bg-line/[.04] px-2 py-0.5 max-w-[280px]"><span class="font-sans text-xs text-fg-muted flex-shrink-0">SSH:</span><span class="truncate">ssh anna@10.0.0.5</span><button type="button" title="SSH-Befehl kopieren" aria-label="SSH-Befehl kopieren" class="btn btn-ghost btn-icon h-[26px] w-[26px] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="lucide lucide-copy-icon lucide-copy">
                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                          </svg></button></div>
                      <div class="flex items-center gap-1.5 rounded-tag border border-faint bg-line/[.04] px-2 py-0.5 min-w-[150px] justify-between">
                        <div class="truncate mr-1"><span class="font-sans text-xs text-fg-muted mr-1">PW:</span><span class="text-fg-muted select-none">••••••••</span></div>
                        <div class="flex items-center gap-0.5 flex-shrink-0"><button type="button" aria-label="Passwort anzeigen" aria-pressed="false" class="btn btn-ghost btn-icon h-[26px] w-[26px]"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="lucide lucide-eye-icon lucide-eye">
                              <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
