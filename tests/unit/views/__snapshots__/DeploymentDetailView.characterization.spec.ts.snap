                  <div data-testid="member-row" class="hover-tint flex flex-col justify-between gap-4 border-b border-faint px-4 py-3 last:border-b-0 lg:flex-row lg:items-center">
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                      <div class="avatar w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-icon lucide-user">
                          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
