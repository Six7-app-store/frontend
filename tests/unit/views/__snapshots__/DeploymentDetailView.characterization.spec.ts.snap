                        <rect x="8" y="8" width="8" height="8" rx="1"></rect>
                      </svg>
                      <div class="space-y-0.5">
                        <p>m1.small · 1 vCPU · 2 GB RAM · 20 GB</p>
                        <p class="text-fg-muted font-mono"> Image-ID: img-1234… </p>
                        <p class="text-fg-muted"> AZ: nova</p>
                        <!--v-if-->
                      </div>
                    </div><!-- Addresses -->
                    <div class="flex items-start gap-2 text-xs text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide mt-0.5 shrink-0 text-icon lucide-network-icon lucide-network mt-0.5 shrink-0 text-icon">
                        <rect x="16" y="16" width="6" height="6" rx="1"></rect>
                        <rect x="2" y="16" width="6" height="6" rx="1"></rect>
                        <rect x="9" y="2" width="6" height="6" rx="1"></rect>
